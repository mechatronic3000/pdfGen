SUB pdfSetPosition (x AS LONG, y AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Sets the position where text will be drawn. Positions are relative.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   x - position
  '_pdf_T   y - position
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11T
  '_pdf_T  '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T  pdfSetTitle "PDF SetPosition Example"
  '_pdf_T  pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T  pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T
  '_pdf_T  pdfAddPage
  '_pdf_T
  '_pdf_T  pdfBeginText
  '_pdf_T  pdfSetFontSize "F1", 24
  '_pdf_T  pdfSetPosition 120, 350
  '_pdf_T  pdfAddText "This is 120,350."
  '_pdf_T  pdfSetPosition 60, 60
  '_pdf_T  pdfAddText "This is 60, 60 from previous position."
  '_pdf_T  pdfEndText
  '_pdf_T
  '_pdf_T  pdfGen "pdfSetPositionExample.pdf"
  '_pdf_T  SYSTEM
  '_pdf_T
  '_pdf_T  '$INCLUDE:'pdfGen.bm'
  '_pdf_T
  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_SET_POSITION
  pdfCommand(ub).argVec1.x = x
  pdfCommand(ub).argVec1.y = y
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfAddText (s AS STRING)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Adds text to the page. Good for short text.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   s - Text string
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF AddText Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 24
  '_pdf_T pdfSetPosition 200, 350
  '_pdf_T
  '_pdf_T pdfAddText "This is some short text."
  '_pdf_T
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfAddTextExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bm'


  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_TEXT
  pdfCommand(ub).s = escapeSeq(s)
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
  pdfStates.text = True
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfAddTextBlock (l AS LONG, s AS STRING)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Adds text to the page. Will start a new line after exceeds a specified length.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   l - Length in characters to start a new line.
  '_pdf_T   s - Text string
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,11W80L11T
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF AddTextBlock Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 24
  '_pdf_T pdfSetPosition 30, 450
  '_pdf_T pdfSetLeading 26 'Must be set before calling pdfAddTextBlock
  '_pdf_T
  '_pdf_T 'Moby Dick - Herman Melville
  '_pdf_T pdfAddTextBlock 60, "Call me Ishmael. Some years ago - never mind how long precisely - having little or no money in my purse, and nothing particular to interest me on shore, I thought I would sail about a little and see the watery part of the world."
  '_pdf_T
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfAddTextBlockExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_TEXT_BLOCK
  pdfCommand(ub).s = escapeSeq(s)
  pdfCommand(ub).argLong1 = l
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
  pdfStates.text = True
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
FUNCTION pdfAddTextBlockEx$ (lmax AS LONG, lcMax AS LONG, s AS STRING)
  '_pdf_)
  '_pdf_@F1,12W60L14
  '_pdf_T
  '_pdf_T Adds text to the page. Will start a new line after exceeds a specified length. If the line count exceeds lcMax the function will return the left over text.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,12W80L14
  '_pdf_T   lmax - Length in characters to start a new line.
  '_pdf_T   lcMax - Number of lines before returning the left over text.
  '_pdf_T   s - Text string
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16
  '_pdf_T   Returns a string with the left over text.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF AddTextBlockEx Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 30, 720
  '_pdf_T pdfSetFontSize "F1", 18
  '_pdf_T pdfSetLeading 20
  '_pdf_T FOR l& = 1 TO 400: bigString$ = bigString$ + RandomWord + " ": NEXT
  '_pdf_T lineCount& = 33 ' Set the line count max.
  '_pdf_T charCount& = 48
  '_pdf_T DO
  '_pdf_T   bigString$ = pdfAddTextBlockEx(charCount&, lineCount&, bigString$)
  '_pdf_T   IF LEN(bigString$) > 0 THEN ' Start a new page
  '_pdf_T     pdfEndText 'End the text block
  '_pdf_T     pdfAddPage ' Add a page
  '_pdf_T     pdfBeginText ' Begin New Text Block
  '_pdf_T     pdfSetFontSize "F1", 18
  '_pdf_T     pdfSetPosition 30, 720
  '_pdf_T     pdfSetLeading 20
  '_pdf_T   END IF
  '_pdf_T LOOP WHILE LEN(bigString$) > 0
  '_pdf_T pdfEndText
  '_pdf_T pdfGen "pdfAddTextBlockEx_Example.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'
  '_pdf_T
  '_pdf_T FUNCTION RandomWord$
  '_pdf_T   consonants$ = "BCDFGHJKLMNPRSTVWYZ": vowels$ = "AEIOU"
  '_pdf_T   Z& = (RND * 2) + 2
  '_pdf_T   FOR X& = 1 TO Z&
  '_pdf_T     B& = (RND * 19) + 1: c$ = c$ + MID$(consonants$, B&, 1)
  '_pdf_T     IF LEN(c$) > 4 THEN vowels$ = "AEIOUY"
  '_pdf_T     B& = (RND * 4) + 1: c$ = c$ + MID$(vowels$, B&, 1)
  '_pdf_T   NEXT
  '_pdf_T   B& = (RND * 4)
  '_pdf_T   IF B& >= 1 AND LEN(c$) > 5 THEN c$ = LEFT$(c$, LEN(c$) - 1)
  '_pdf_T   RandomWord$ = c$
  '_pdf_T END FUNCTION


  DIM AS STRING tempStr: tempStr = s
  DIM AS STRING lf
  DIM AS LONG ln, sp, lc
  lc = 0
  DO
    ln = _IIF(LEN(tempStr) > lmax, lmax, LEN(tempStr))
    sp = _INSTRREV(ln, tempStr, " ")
    IF sp > 0 AND LEN(tempStr) > lmax THEN ln = sp
    lf = LEFT$(tempStr, ln)
    tempStr = MID$(tempStr, ln + 1)
    IF lc > 0 THEN
      pdfNextLine
    END IF
    pdfAddText lf
    lc = lc + 1
    IF lc > lcMax THEN EXIT DO
  LOOP WHILE LEN(tempStr) > 0
  pdfAddTextBlockEx$ = tempStr
END FUNCTION
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfBeginText
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Starts a text block. All text operations must be done within a block. Resets position back to lower left corner.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   None.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF BeginText Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T
  '_pdf_T pdfSetFontSize "F1", 14
  '_pdf_T pdfSetPosition 150, 350 'Initial position
  '_pdf_T pdfAddText "This is some text."
  '_pdf_T pdfSetPosition 20, 20 'Relative position
  '_pdf_T pdfAddText " This some more text."
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginText 'Resets back to lower left
  '_pdf_T
  '_pdf_T pdfSetFontSize "F1", 14
  '_pdf_T pdfSetPosition 150, 300
  '_pdf_T pdfAddText "This is some text."
  '_pdf_T pdfSetPosition 20, 20 'Relative position
  '_pdf_T pdfAddText " This some more text."
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfBeginTextExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_BEGIN_TEXT
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
  pdfStates.text = True
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfEndText
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
