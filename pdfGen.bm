'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfMediaBox (x AS LONG,  y AS LONG, _
x1 AS LONG, y1 AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T  The media box defines the boundaries of the physical medium on which the page is to be printed. It may include any extended area surrounding the finished page for bleed, printing marks, or other such purposes. Must be done before page is added.
  '_pdf_T  The default values are 0,0,612,792. Changing the media box will automatically set the crop box to the same values.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   x,y - lower left corner
  '_pdf_T   x1,y1 - upper right corner
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11T
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF MediaBox Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfMediaBox 0, 0, 2048, 600
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 24
  '_pdf_T pdfSetPosition 900, 500
  '_pdf_T pdfAddText "Wide Page"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfMediaBox 0, 0, 600, 2048
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 24
  '_pdf_T pdfSetPosition 270, 1948
  '_pdf_T pdfAddText "Long Page"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfMediaBox.pdf"
  '_pdf_T SYSTEM
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bm'


  pdfDefault.mediaBox.a.x = x
  pdfDefault.mediaBox.a.y = y
  pdfDefault.mediaBox.b.x = x1
  pdfDefault.mediaBox.b.y = y1

  pdfDefault.cropBox.a.x = x
  pdfDefault.cropBox.a.y = y
  pdfDefault.cropBox.b.x = x1
  pdfDefault.cropBox.b.y = y1
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfCropBox (x AS LONG,  y AS LONG, _
x1 AS LONG, y1 AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T  The crop box defines the region to which the contents of the page are to be clipped (cropped) when displayed or printed. Unlike the other boxes, the crop box has no defined meaning in terms of physical page geometry or intended use; it merely imposes clipping on the page contents. Must be done before page is added.
  '_pdf_T  The default values are 0,0,612,792.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   x,y - lower left corner
  '_pdf_T   x1,y1 - upper right corner
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF CropBox Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 100
  '_pdf_T pdfSetPosition 25, 350
  '_pdf_T pdfAddText "Cropped Text"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfCropBox 100, 100, 512, 692
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 100
  '_pdf_T pdfSetPosition 25, 350
  '_pdf_T pdfAddText "Cropped Text"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfCropBox.pdf"
  '_pdf_T SYSTEM
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  pdfDefault.cropBox.a.x = x
  pdfDefault.cropBox.a.y = y
  pdfDefault.cropBox.b.x = x1
  pdfDefault.cropBox.b.y = y1
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfSetImageDevice (imdev AS _UNSIGNED _BYTE)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Sets the current image device. Specifying colors in a device color space (DeviceGray, DeviceRGB, or DeviceCMYK) makes them device-dependent. By setting default color spaces (PDF 1.1), a PDF document can request that such colors be systematically transformed (remapped) into device-independent CIE-based color spaces.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  imdev - PDF_IMAGE_DEVICE_GRAY, PDF_IMAGE_DEVICE_RGB, or PDF_IMAGE_DEVICE_CMYK  are valid contants.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T

  pdfDefault.imageDevice = imdev
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfLoadImage (f AS STRING, nm AS STRING)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T  Loads an image and prepares it for use in the document.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  f - Filename of image
  '_pdf_T  nm - ID of image to be used later
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T
  IF NOT _FILEEXISTS(f) THEN PRINT "Image "; f; " was not loaded!!!!! Check file path.": END
  DIM AS LONG ub
  ub = UBOUND(pdfImage)
  pdfImage(ub).IMG = _LOADIMAGE(f, 32)
  IF pdfImage(ub).IMG >= -1 THEN
    $IF PDFLOG = TRUE THEN
      PRINT #pdflogfile, "Image "; f; " was not loaded!!!!! Check file path."
    $END IF
  ELSE
    $IF PDFLOG = TRUE THEN
      PRINT #pdflogfile, "Image "; f; " was successfully loaded! Handle returned was "; pdfImage(ub).IMG; "."
      PRINT #pdflogfile, "Image internal handle is "; nm; " using "; pdfImage(ub).imageDevice; " image device."
    $END IF
  END IF

  pdfImage(ub).nm = nm
  pdfImage(ub).imageDevice = pdfDefault.imageDevice
  IF pdfImage(ub).IMG < -1 THEN
    REDIM _PRESERVE pdfImage(ub + 1) AS tPDFIMAGE
    pdfStates.imgCount = pdfStates.imgCount + 1
    IF pdfDefault.imageDevice = PDF_IMAGE_DEVICE_GRAY THEN
      pdfStates.proc = pdfStates.proc OR PDF_PROC_IMAGEB
    ELSE
      pdfStates.proc = pdfStates.proc OR PDF_PROC_IMAGEC
    END IF
  END IF
END SUB
