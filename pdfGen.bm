SUB pdfSetFontSize (nm AS STRING, sz AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Sets the current loaded font and size.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   nm - ID of font that was previously loaded.
  '_pdf_T   sz - size of font
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF SetFontSize Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 50, 750 'Initial position
  '_pdf_T FOR i& = 0 TO 28
  '_pdf_T   fSize& = 8 + i&
  '_pdf_T   pdfSetFontSize "F1", fSize&
  '_pdf_T   pdfSetLeading fSize&
  '_pdf_T   pdfAddText "This is fontSize " + STR$(fSize&) + "."
  '_pdf_T   pdfNextLine
  '_pdf_T NEXT
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfSetFontSizeExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_SET_FONT_SIZE
  pdfCommand(ub).s = nm: pdfStates.font_name = nm
  pdfCommand(ub).argLong1 = sz: pdfStates.font_size = sz
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
  pdfStates.text = True
  pdfStates.font_set = True
END SUB
'_pdf_E+#40,740@F2,14W60L16
