SUB pdfRectangle (x AS LONG, y AS LONG, _
w AS LONG, h AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Append a rectangle to the current path as a complete subpath, with lower-left corner (x, y) and dimensions width and height in user space.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   x,y - lower-left corner
  '_pdf_T   w,h - width and height
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF Rectangle Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T xC! = 150
  '_pdf_T yC! = 350
  '_pdf_T w! = 300
  '_pdf_T h! = 300
  '_pdf_T
  '_pdf_T pdfSetStrokeWidth 4
  '_pdf_T FOR i& = 0 TO 100 STEP 10
  '_pdf_T   pdfRectangle xC! + i&, yC! + i&, w! - (i& * 2), h! - (i& * 2)
  '_pdf_T   pdfStrokePath
  '_pdf_T NEXT
  '_pdf_T
  '_pdf_T pdfGen "pdfRectangleExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_RECTANGLE
  pdfCommand(ub).argVec1.x = x
  pdfCommand(ub).argVec1.y = y
  pdfCommand(ub).argVec2.x = w
  pdfCommand(ub).argVec2.y = h
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfStrokePath
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Stroke the previously created path. It does not close the path. Subsequent path operations will continue from the last path operation.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  None.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_E+#40,740@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W100L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF General Path Showcase Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T pdfSetStrokeWidth 4
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 18
  '_pdf_T pdfSetPosition 100, 710
  '_pdf_T pdfAddText "StrokePath Example (Does not close shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginPath 100, 700
  '_pdf_T pdfAppendLine 500, 700
  '_pdf_T pdfAppendLine 500, 650
  '_pdf_T pdfAppendLine 100, 650
  '_pdf_T pdfStrokePath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 610
  '_pdf_T pdfAddText "CloseStrokePath Example (Closes shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginPath 100, 600
  '_pdf_T pdfAppendLine 500, 600
  '_pdf_T pdfAppendLine 500, 550
  '_pdf_T pdfAppendLine 100, 550
  '_pdf_T pdfCloseStrokePath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 510
  '_pdf_T pdfAddText "FillPath Example (Fills shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfSetStrokeWidth 1
  '_pdf_T rad! = 75: xc! = 300: yc! = 420
  '_pdf_T star rad!, xc!, yc!
  '_pdf_T pdfFillPath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 300
  '_pdf_T pdfAddText "FillEO Example (Fills Even Odd Shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T rad! = 75: xc! = 300: yc! = 200
  '_pdf_T star rad!, xc!, yc!
  '_pdf_T pdfFillEO
  '_pdf_T
  '_pdf_T pdfGen "pdfPathShowcaseExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  '_pdf_T SUB star (rad!, xc!, yc!)
  '_pdf_T   pdfBeginPath xc! + rad! * SIN(0), yc! + rad! * COS(0)
  '_pdf_T   FOR i! = 1 TO 5
  '_pdf_T   pdfAppendLine xc! + rad! * SIN(_D2R(i! * 144)), yc! + rad! * COS(_D2R(i! * 144))
  '_pdf_T   NEXT
  '_pdf_T END SUB

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_STROKE_PATH
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
