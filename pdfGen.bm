SUB pdfBeginPath (x AS LONG, y AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T A path is a set sequential points in which a draw command renders them to the current page. All paths must have a starting point. pdfBeginPath sets the starting point of a path.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   x,y - position of the start of the path
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W90L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF BeginPath Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T xC! = 300
  '_pdf_T yC! = 350
  '_pdf_T rad! = 250
  '_pdf_T deg! = 0
  '_pdf_T
  '_pdf_T pdfBeginPath xC! + rad! * SIN(_D2R(deg!)), yC! + rad! * COS(_D2R(deg!))
  '_pdf_T
  '_pdf_T FOR i& = 0 TO 249
  '_pdf_T   deg! = deg! + 91
  '_pdf_T   rad! = rad! - 1
  '_pdf_T   pdfAppendLine xC! + rad! * SIN(_D2R(deg!)), yC! + rad! * COS(_D2R(deg!))
  '_pdf_T NEXT
  '_pdf_T pdfStrokePath
  '_pdf_T
  '_pdf_T pdfGen "pdfBeginPathExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_BEGIN_PATH
  pdfCommand(ub).argVec1.x = x
  pdfCommand(ub).argVec1.y = y
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
