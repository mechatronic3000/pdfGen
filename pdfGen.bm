SUB pdfSetGrayScaleStroke (g AS SINGLE)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Sets the color space to grayscale and stroke to grayscale color.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   Grayscale color 0.0-1.0
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF GrayScaleStroke Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T c# = 0.0
  '_pdf_T FOR y& = 1 TO 5
  '_pdf_T   pdfSetStrokeWidth 10
  '_pdf_T   pdfSetGrayScaleStroke c#
  '_pdf_T   pdfBeginPath 100, 550 - y& * 20
  '_pdf_T   pdfAppendLine 500, 550 - y& * 20
  '_pdf_T   pdfStrokePath
  '_pdf_T
  '_pdf_T   pdfSetGrayScaleStroke 0
  '_pdf_T   pdfSetStrokeWidth 1
  '_pdf_T   pdfRectangle 100, 545 - y& * 20, 400, 10
  '_pdf_T   pdfStrokePath
  '_pdf_T
  '_pdf_T   pdfBeginText
  '_pdf_T   pdfSetFontSize "F1", 10
  '_pdf_T   pdfSetPosition 240, 547 - y& * 20
  '_pdf_T   pdfSetGrayScaleNonStroke (1 - c#) * -(y& <> 3)
  '_pdf_T   pdfAddText "Grayscale : " + STR$(c#)
  '_pdf_T   pdfEndText
  '_pdf_T   c# = c# + .25
  '_pdf_T NEXT
  '_pdf_T pdfGen "pdfGrayScaleStroketExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'


  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_GRAYSCALE_STROKE
  pdfCommand(ub).argSingle1 = g
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
