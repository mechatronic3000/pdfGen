SUB pdfAddPage
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Adds a page to the document. A page must always be added. Once a new page is added you cannot edit previous pages.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  None.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF AddPage Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 64
  '_pdf_T pdfSetPosition 120, 350
  '_pdf_T pdfAddText "This is a page"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 64
  '_pdf_T pdfSetPosition 35, 350
  '_pdf_T pdfAddText "This is another page"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfAddPageExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub, pgs
  ub = UBOUND(pdfPage)
  pdfPage(ub).mediaBox = pdfDefault.mediaBox
  pdfPage(ub).cropBox = pdfDefault.cropBox
  pdfPage(ub).ll.parent = ub - 1
  pdfPage(ub).ll.child = ub + 1
  pgs = ub
  REDIM _PRESERVE pdfPage(ub + 1) AS tPDFPAGE
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_ADD_PAGE
  pdfCommand(ub).argLong1 = pdfStates.pageCount
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
  pdfStates.pageCount = pdfStates.pageCount + 1
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfLoadFont (nm AS STRING, fnt AS STRING)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Loads an internal font and assigns an ID. Fonts must be loaded before use. Constants have been included in the Library.
  '_pdf_@F1,10W80L12
  '_pdf_T * Times-Roman      * Helvetica             * Courier
  '_pdf_T * Times-Bold       * Helvetica-Bold        * Courier-Bold
  '_pdf_T * Times-Italic     * Helvetica-Oblique     * Courier-Oblique
  '_pdf_T * Times-BoldItalic * Helvetica-BoldOblique * Courier-BoldOblique
  '_pdf_T                    * Symbol
  '_pdf_T                    * ZapfDingbats
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  nm  - Id that the user assigns to the font ex. F1
  '_pdf_T  fnt - name of internal font ex. Times-Roman
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,6W80L7T'$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF Load Font Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T pdfLoadFont "F1", PDF_FONT_COURIER
  '_pdf_T pdfLoadFont "F2", PDF_FONT_COURIER_BOLD
  '_pdf_T pdfLoadFont "F3", PDF_FONT_COURIER_OBLIQUE
  '_pdf_T pdfLoadFont "F4", PDF_FONT_COURIER_BOLD_OBLIQUE
  '_pdf_T pdfLoadFont "F5", PDF_FONT_HELVETICA
  '_pdf_T pdfLoadFont "F6", PDF_FONT_HELVETICA_BOLD
  '_pdf_T pdfLoadFont "F7", PDF_FONT_HELVETICA_OBLIQUE
  '_pdf_T pdfLoadFont "F8", PDF_FONT_HELVETICA_BOLD_OBLIQUE
  '_pdf_T pdfLoadFont "F9", PDF_FONT_SYMBOL
  '_pdf_T pdfLoadFont "F10", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfLoadFont "F11", PDF_FONT_TIMES_BOLD
  '_pdf_T pdfLoadFont "F12", PDF_FONT_TIMES_ITALIC
  '_pdf_T pdfLoadFont "F13", PDF_FONT_TIMES_BOLD_ITALIC
  '_pdf_T pdfLoadFont "F14", PDF_FONT_ZAPFDINGBATS
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 12
  '_pdf_T pdfSetLeading 15
  '_pdf_T pdfSetPosition 40, 700
  '_pdf_T pdfAddText "Courier": pdfNextLine
  '_pdf_T pdfSetFontSize "F2", 12
  '_pdf_T pdfAddText "Courier Bold": pdfNextLine
  '_pdf_T pdfSetFontSize "F3", 12
  '_pdf_T pdfAddText "Courier Oblique": pdfNextLine
  '_pdf_T pdfSetFontSize "F4", 12
  '_pdf_T pdfAddText "Courier Bold Oblique": pdfNextLine
  '_pdf_T pdfSetFontSize "F5", 12
  '_pdf_T pdfAddText "Helvetica": pdfNextLine
  '_pdf_T pdfSetFontSize "F6", 12
  '_pdf_T pdfAddText "Helvetica Bold": pdfNextLine
  '_pdf_T pdfSetFontSize "F7", 12
  '_pdf_T pdfAddText "Helvetica Oblique": pdfNextLine
  '_pdf_T pdfSetFontSize "F8", 12
  '_pdf_T pdfAddText "Helvetica Bold Oblique": pdfNextLine
  '_pdf_T pdfSetFontSize "F1", 12
  '_pdf_T pdfAddText "Symbol  ": pdfSetFontSize "F9", 12: pdfAddText "abcdefgh": pdfNextLine
  '_pdf_T pdfSetFontSize "F10", 12
  '_pdf_T pdfAddText "Times Roman": pdfNextLine
  '_pdf_T pdfSetFontSize "F11", 12
  '_pdf_T pdfAddText "Times Bold": pdfNextLine
  '_pdf_T pdfSetFontSize "F12", 12
  '_pdf_T pdfAddText "Times Italic": pdfNextLine
  '_pdf_T pdfSetFontSize "F13", 12
  '_pdf_T pdfAddText "Times Bold Italic": pdfNextLine
  '_pdf_T pdfSetFontSize "F1", 12
  '_pdf_T pdfAddText "ZAPFDINGBATS  ": pdfSetFontSize "F14", 12: pdfAddText "abcdefgh": pdfNextLine
  '_pdf_T pdfEndText
  '_pdf_T pdfGen "pdfLoadFontExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfFont)
  pdfFont(ub).font_name = nm
  pdfFont(ub).font = fnt
  pdfFont(ub).font_size = sz
  pdfFont(ub).encoding = pdfDefault.fontEncoding
  pdfPage(UBOUND(pdfPage) - 1).font = nm
  REDIM _PRESERVE pdfFont(ub + 1) AS tPDFFONT
END SUB

FUNCTION pdfAddObject (obtype AS LONG)
  DIM AS LONG ub
  ub = UBOUND(pdfObject)
  pdfObject(ub).obtype = obtype
  REDIM _PRESERVE pdfObject(ub + 1) AS tPDFOBJECT
  pdfAddObject = ub
END FUNCTION
