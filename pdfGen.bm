SUB pdfSetLineCapStyle (c AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T The line cap style specifies the shape to be used at the ends of open subpaths (and dashes, if any) when they are stroked.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  c - PDF_LINE_CAP_BUTT, PDF_LINE_CAP_ROUND, or PDF_LINE_CAP_PROJECTING_SQUARE
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_LINE_CAP_STYLE
  pdfCommand(ub).argLong1 = c
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB

'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfSetLineJoinStyle (c AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T The line join style specifies the shape to be used at the corners of paths that are stroked.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   c - PDF_LINE_JOIN_MITER, PDF_LINE_JOIN_ROUND, or PDF_LINE_JOIN_BEVEL
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_LINE_JOIN_STYLE
  pdfCommand(ub).argLong1 = c
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfSetLineDashPattern (ondash AS LONG, offdash AS LONG, phase AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T The line dash pattern controls the pattern of dashes and gaps used to stroke paths. It is specified by a dash array and a dash phase. The dash array's elements are numbers that specify the lengths of alternating dashes and gaps; the dash phase specifies the distance into the dash pattern at which to start the dash. The elements of both the dash array and the dash phase are expressed in user space units.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   ondash - number of units ON
  '_pdf_T   offdash - number of units OFF
  '_pdf_T   phase - units of offset
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_LINE_DASH_PATTERN
  pdfCommand(ub).argLong1 = ondash
  pdfCommand(ub).argLong2 = offdash
  pdfCommand(ub).argLong3 = phase
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB

'======================================================================================================================================
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfGen (filename AS STRING)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Generates the PDF document.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  Filename - string
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   PDF file.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T

  '_pdf_EG'pdfGenDocs.pdf'

  DIM AS LONG i, pageCount, fontCount, catalogObj, outlineObj, imgObj, infoObj
  DIM AS LONG pgs, pg, content, procObj, fnt, xref, trailer
  DIM AS LONG cnt, xrs, xrefStart, eoff, fln
  DIM AS STRING textStream, mediaBox, cropBox
  DIM AS STRING resString, b



  pageCount = UBOUND(pdfPage) - 1
  fontCount = UBOUND(pdfFont) - 1
  DIM AS LONG pageKids(pageCount)
  $IF PDFLOG = TRUE THEN
    PRINT #pdflogfile, "Page Count:"; pageCount
    PRINT #pdflogfile, "Font Count:"; fontCount
    PRINT #pdflogfile, "Image Count:"; pdfStates.imgCount
  $END IF


  catalogObj = pdfAddObject(PDF_OBJECT_TYPE_CATALOG)
  outlineObj = pdfAddObject(PDF_OBJECT_TYPE_OUTLINES)

  infoObj = pdfAddObject(PDF_OBJECT_TYPE_INFO)
  pdfObject(infoObj).objectString = PDF_ADD_OBJECT_PRE("", infoObj, 0)
  pdfObject(infoObj).objectString = PDF_ADD_DOCUMENT_INFO$(pdfObject(infoObj).objectString)
  pdfObject(infoObj).objectString = PDF_ADD_OBJECT_POST$(pdfObject(infoObj).objectString)

  procObj = pdfAddObject(PDF_OBJECT_TYPE_PROCEDURE)
  pgs = pdfAddObject(PDF_OBJECT_TYPE_PAGES)

  pdfObject(catalogObj).arg1 = pdfObject(catalogObj).arg1 + trimV$(pgs) + " 0 R "
  pdfObject(catalogObj).arg2 = pdfObject(catalogObj).arg2 + trimV$(outlineObj) + " 0 R "

  pdfObject(catalogObj).objectString = PDF_ADD_OBJECT_PRE("", catalogObj, 0)
  pdfObject(catalogObj).objectString = PDF_ADD_CATALOG$(pdfObject(catalogObj).objectString, pdfObject(catalogObj).arg1, pdfObject(catalogObj).arg2)
  pdfObject(catalogObj).objectString = PDF_ADD_OBJECT_POST$(pdfObject(catalogObj).objectString)

  pdfObject(outlineObj).objectString = PDF_ADD_OBJECT_PRE("", outlineObj, 0)
  pdfObject(outlineObj).objectString = PDF_ADD_OUTLINES$(pdfObject(outlineObj).objectString)
  pdfObject(outlineObj).objectString = PDF_ADD_OBJECT_POST$(pdfObject(outlineObj).objectString)

  pdfObject(procObj).objectString = PDF_ADD_OBJECT_PRE("", procObj, 0)
  pdfObject(procObj).objectString = PDF_ADD_PROC$(pdfObject(procObj).objectString, pdfStates.proc)
  pdfObject(procObj).objectString = PDF_ADD_OBJECT_POST$(pdfObject(procObj).objectString)

  FOR i = 1 TO pdfStates.imgCount
    imgObj = pdfAddObject(PDF_OBJECT_TYPE_IMAGE)
    pdfImage(i).obj = imgObj
    pdfObject(imgObj).arg1 = pdfImage(i).nm
    pdfObject(imgObj).objectString = PDF_ADD_OBJECT_PRE("", imgObj, 0)
    pdfObject(imgObj).objectString = PDF_ADD_IMAGE$(pdfObject(imgObj).objectString, i)
    pdfObject(imgObj).objectString = PDF_ADD_OBJECT_POST$(pdfObject(imgObj).objectString)
  NEXT

  FOR i = 1 TO pageCount
    pg = pdfAddObject(PDF_OBJECT_TYPE_PAGE)
    content = pdfAddObject(PDF_OBJECT_TYPE_CONTENT)

    pageKids(i) = pg ' store the page objects, so that we can possibly rearrange later

    pdfObject(pg).arg1 = pdfObject(pg).arg1 + trimV$(content) + " 0 R " 'Content
    pdfObject(pg).arg2 = pdfObject(pg).arg2 + trimV$(pgs) + " 0 R " 'Parent
    pdfObject(pg).arg4 = pdfObject(pg).arg4 + trimV$(procObj) + " 0 R " 'Procset
    pdfObject(pg).pageNumber = i
    pdfObject(content).pageNumber = i
    pdfPage(i).object = content
    $IF PDFLOG = TRUE THEN
      PRINT #pdflogfile, "pg:"; i; "    LL:"; pdfPage(i).ll.parent; "   "; pdfPage(i).ll.child
    $END IF
  NEXT

  ' Perhaps add the ability to insert pages in pdfObject(pgs).arg1, so
  ' late coming pages can be put in the list in any order
  FOR i = 1 TO pageCount
    pdfObject(pgs).arg1 = pdfObject(pgs).arg1 + trimV$(pageKids(i)) + " 0 R " ' Fill in the kids for pages
  NEXT

  pdfObject(pgs).objectString = PDF_ADD_OBJECT_PRE("", pgs, 0)
  pdfObject(pgs).objectString = PDF_ADD_PAGES(pdfObject(pgs).objectString, pageCount, pdfObject(pgs).arg1)
  pdfObject(pgs).objectString = PDF_ADD_OBJECT_POST$(pdfObject(pgs).objectString)

  resString = ""

  FOR i = 1 TO fontCount
    fnt = pdfAddObject(PDF_OBJECT_TYPE_FONT)
    pdfObject(fnt).arg1 = pdfObject(fnt).arg1 + pdfFont(i).font_name
    pdfObject(fnt).arg2 = pdfObject(fnt).arg2 + pdfFont(i).font
    pdfObject(fnt).objectString = PDF_ADD_OBJECT_PRE("", fnt, 0) + _
                                  PDF_ADD_FONT$("", pdfObject(fnt).arg1, pdfObject(fnt).arg2, pdffont(i).encoding) + _
                                  PDF_ADD_OBJECT_POST$("")
    resString = resString + "/" + pdfFont(i).font_name + " " + trimV$(fnt) + " 0 R" + CHR$(13)
  NEXT

  FOR i = 1 TO UBOUND(pdfObject) - 1
    IF pdfObject(i).obtype = PDF_OBJECT_TYPE_PAGE THEN
      mediabox = trimV(pdfPage(pdfObject(i).pageNumber).mediaBox.a.x) + " " _
               + trimV(pdfPage(pdfObject(i).pageNumber).mediaBox.a.y) + " " _
               + trimV(pdfPage(pdfObject(i).pageNumber).mediaBox.b.x) + " " _
               + trimV(pdfPage(pdfObject(i).pageNumber).mediaBox.b.y)
      cropbox  = trimV(pdfPage(pdfObject(i).pageNumber).cropBox.a.x) + " " _
               + trimV(pdfPage(pdfObject(i).pageNumber).cropBox.a.y) + " " _
               + trimV(pdfPage(pdfObject(i).pageNumber).cropBox.b.x) + " " _
               + trimV(pdfPage(pdfObject(i).pageNumber).cropBox.b.y)

      pdfObject(i).arg3 = resString
      pdfObject(i).objectString = PDF_ADD_OBJECT_PRE("", i, 0)
      pdfObject(i).objectString = PDF_ADD_PAGE$(pdfObject(i).objectString, pdfObject(i).arg2, pdfObject(i).arg3, pdfObject(i).arg4, pdfObject(i).arg1, mediaBox, cropBox)
      pdfObject(i).objectString = PDF_ADD_OBJECT_POST$(pdfObject(i).objectString)
    END IF
  NEXT

  '------------------------------------------------------------------------
  textStream = ""
  FOR i = 0 TO UBOUND(pdfCommand) - 1
    SELECT CASE pdfCommand(i).command
      CASE PDF_COMM_BEGIN_TEXT
        textStream = textStream + PDF_BEGIN_TEXT_OPERATOR + CHR$(13)
      CASE PDF_COMM_END_TEXT
        textStream = textStream + PDF_END_TEXT_OPERATOR + CHR$(13)
      CASE PDF_COMM_ADD_PAGE
        pdfObject(pdfPage(pdfStates.current_page).object).objectString = PDF_ADD_OBJECT_PRE("", pdfPage(pdfStates.current_page).object, 0) + PDF_ADD_PAGE_CONTENT$("", textStream) + PDF_ADD_OBJECT_POST$("")
        pdfStates.current_page = pdfStates.current_page + 1
        textStream = ""
      CASE PDF_COMM_SET_POSITION
        textStream = textStream + trimV(pdfCommand(i).argVec1.x) + " " + trimV(pdfCommand(i).argVec1.y) + " Td" + CHR$(13)
      CASE PDF_COMM_TEXT
        'Put pdfVar values into string now
        ' Per spec a line cannot exceed 256 characters, unless it is a compressed stream
        IF LEN(pdfCommand(i).s) > 240 THEN pdfCommand(i).s = LEFT$(pdfCommand(i).s, 240)
        textStream = textStream + " (" + pdfCommand(i).s + ") Tj" + CHR$(13)
      CASE PDF_COMM_TEXT_BLOCK
        'Put pdfVar values into string now
        DIM AS STRING tempStr: tempStr = pdfCommand(i).s
        DIM AS STRING lf
        DIM AS LONG ln, sp, lc
        lc = 0
        DO
          ln = _IIF(LEN(tempStr) > pdfCommand(i).argLong1, pdfCommand(i).argLong1, LEN(tempStr))
          sp = _INSTRREV(ln, tempStr, " ")
          IF sp > 0 AND LEN(tempStr) > pdfCommand(i).argLong1 THEN ln = sp
          lf = LEFT$(tempStr, ln)
          tempStr = MID$(tempStr, ln + 1)
          IF lc = 0 THEN
            textStream = textStream + " (" + lf + ") Tj" + CHR$(13)
          ELSE
            textStream = textStream + "T* (" + lf + ") Tj" + CHR$(13)
          END IF
          lc = lc + 1
        LOOP WHILE LEN(tempStr) > 0
      CASE PDF_COMM_SET_FONT_SIZE
        textStream = textStream + "/" + pdfCommand(i).s + " " + trimV(pdfCommand(i).argLong1) + " Tf" + CHR$(13)
      CASE PDF_COMM_SET_MATRIX
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).mat.a)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.b)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.c)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.d)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.e)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.f)) + " Tm" + CHR$(13)
      CASE PDF_COMM_SET_IMAGE_MATRIX
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).mat.a)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.b)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.c)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.d)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.e)) + " " + _
                                  trimV(fixDecNot!(pdfCommand(i).mat.f)) + " cm" + CHR$(13)
      CASE PDF_COMM_TEXT_RENDER_MODE
        textStream = textStream + trimV(pdfCommand(i).argLong1) + " Tr" + CHR$(13)
      CASE PDF_COMM_GRAYSCALE_STROKE
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " G" + CHR$(13)
      CASE PDF_COMM_GRAYSCALE_NONSTROKE
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " g" + CHR$(13)
      CASE PDF_COMM_STROKE_WIDTH
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " w" + CHR$(13)
      CASE PDF_COMM_HORIZONTAL_SCALE
        textStream = textStream + trimV(pdfCommand(i).argLong1) + " Tz" + CHR$(13)
      CASE PDF_COMM_CHARACTER_SPACING
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " Tc" + CHR$(13)
      CASE PDF_COMM_WORD_SPACING
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " Tw" + CHR$(13)
      CASE PDF_COMM_TEXT_LEADING
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " TL" + CHR$(13)
      CASE PDF_COMM_TEXT_RISE
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " Ts" + CHR$(13)
      CASE PDF_COMM_NEXT_LINE
        textStream = textStream + " T* "
      CASE PDF_COMM_BEGIN_PATH
        textStream = textStream + trimV(pdfCommand(i).argVec1.x) + " " + trimV(pdfCommand(i).argVec1.y) + " m" + CHR$(13)
      CASE PDF_COMM_APPEND_LINE
        textStream = textStream + trimV(pdfCommand(i).argVec1.x) + " " + trimV(pdfCommand(i).argVec1.y) + " l" + CHR$(13)
      CASE PDF_COMM_APPEND_BEZIER_CURVE_123
        textStream = textStream + trimV(pdfCommand(i).argVec1.x) + " " + trimV(pdfCommand(i).argVec1.y) + " " +_
                                  trimV(pdfCommand(i).argVec2.x) + " " + trimV(pdfCommand(i).argVec2.y) + " " +_
                                  trimV(pdfCommand(i).argVec3.x) + " " + trimV(pdfCommand(i).argVec3.y) + " c" + CHR$(13)
      CASE PDF_COMM_APPEND_BEZIER_CURVE_23
        textStream = textStream + trimV(pdfCommand(i).argVec2.x) + " " + trimV(pdfCommand(i).argVec2.y) + " " +_
                                  trimV(pdfCommand(i).argVec3.x) + " " + trimV(pdfCommand(i).argVec3.y) + " v" + CHR$(13)
      CASE PDF_COMM_APPEND_BEZIER_CURVE_13
        textStream = textStream + trimV(pdfCommand(i).argVec1.x) + " " + trimV(pdfCommand(i).argVec1.y) + " " +_
                                  trimV(pdfCommand(i).argVec3.x) + " " + trimV(pdfCommand(i).argVec3.y) + " y" + CHR$(13)
      CASE PDF_COMM_CLOSE_PATH
        textStream = textStream + " h" + CHR$(13)
      CASE PDF_COMM_RECTANGLE
        textStream = textStream + trimV(pdfCommand(i).argVec1.x) + " " + trimV(pdfCommand(i).argVec1.y) + " " +_
                                  trimV(pdfCommand(i).argVec2.x) + " " + trimV(pdfCommand(i).argVec2.y) + " re" + CHR$(13)
      CASE PDF_COMM_STROKE_PATH
        textStream = textStream + " S" + CHR$(13)
      CASE PDF_COMM_CLOSE_AND_STROKE
        textStream = textStream + " s" + CHR$(13)
      CASE PDF_COMM_FILL_PATH
        textStream = textStream + " F" + CHR$(13)
      CASE PDF_COMM_FILL_EO
        textStream = textStream + " f*" + CHR$(13)
      CASE PDF_COMM_FILL_STROKE
        textStream = textStream + " B" + CHR$(13)
      CASE PDF_COMM_FILL_STROKE_EO
        textStream = textStream + " B*" + CHR$(13)
      CASE PDF_COMM_CLOSE_FILL_STROKE
        textStream = textStream + " b" + CHR$(13)
      CASE PDF_COMM_CLOSE_FILL_STROKE_EO
        textStream = textStream + " b*" + CHR$(13)
      CASE PDF_COMM_END_PATH
        textStream = textStream + " n" + CHR$(13)
      CASE PDF_COMM_PUSH_GRAPHIC_STACK
        textStream = textStream + " q" + CHR$(13)
      CASE PDF_COMM_POP_GRAPHIC_STACK
        textStream = textStream + " Q" + CHR$(13)
      CASE PDF_COMM_SET_COLOR_STROKE
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " "_
                                + trimV(fixDecNot!(pdfCommand(i).argSingle2)) + " "_
                                + trimV(fixDecNot!(pdfCommand(i).argSingle3)) + " RG" + CHR$(13)
      CASE PDF_COMM_SET_COLOR_NONSTROKE
        textStream = textStream + trimV(fixDecNot!(pdfCommand(i).argSingle1)) + " "_
                                + trimV(fixDecNot!(pdfCommand(i).argSingle2)) + " "_
                                + trimV(fixDecNot!(pdfCommand(i).argSingle3)) + " rg" + CHR$(13)
      CASE PDF_COMM_PUT_IMAGE
        textStream = textStream + "/" + pdfCommand(i).s1 + " Do" + CHR$(13)
      CASE PDF_COMM_LINE_CAP_STYLE
        textStream = textStream + trimV(pdfCommand(i).argLong1) + " J" + CHR$(13)
      CASE PDF_COMM_LINE_JOIN_STYLE
        textStream = textStream + trimV(pdfCommand(i).argLong1) + " j" + CHR$(13)
      CASE PDF_COMM_LINE_DASH_PATTERN
        textStream = textStream + " [" + trimV(pdfCommand(i).argLong1) + _
                                  " " + trimV(pdfCommand(i).argLong2) + _
                                  "] " + trimV(pdfCommand(i).argLong3) + _
                                  " d" + CHR$(13)
    END SELECT
  NEXT

  pdfObject(pdfPage(pdfStates.current_page).object).objectString = PDF_ADD_OBJECT_PRE("", pdfPage(pdfStates.current_page).object, 0) _
                                                                  + PDF_ADD_PAGE_CONTENT$("", textStream ) + PDF_ADD_OBJECT_POST$("")
  pdfObject(0).objectString = PDF_ADD_HEADER$

  cnt = UBOUND(pdfObject)

  b = ""
  FOR i = 0 TO cnt - 1 '-exclude the xref itself
    b = b + pdfObject(i).objectString
  NEXT

  xrefStart = LEN(b)

  xref = pdfAddObject(PDF_OBJECT_TYPE_XREF)
  pdfObject(xref).objectString = PDF_ADD_XREF$("", cnt)

  trailer = pdfAddObject(PDF_OBJECT_TYPE_TRAILER)
  pdfObject(trailer).objectString = PDF_ADD_TRAILER("", cnt, infoObj)

  xrs = pdfAddObject(PDF_OBJECT_TYPE_XREF_START)
  pdfObject(xrs).objectString = PDF_ADD_XREFSTART("", xrefStart)

  eoff = pdfAddObject(PDF_OBJECT_TYPE_EOF)
  pdfObject(eoff).objectString = PDF_ADD_EOF("")
  '------------------------------------------------------------------------
  fln = FREEFILE
  OPEN filename FOR OUTPUT AS #fln
  FOR i = 0 TO UBOUND(pdfObject) - 1
    PRINT #fln, pdfObject(i).objectString
  NEXT
  CLOSE #fln
  $IF PDFLOG = TRUE THEN
    CLOSE #pdflogfile
  $END IF
  clearPdf
END SUB

FUNCTION PDF_ADD_OBJECT_PRE$ (in AS STRING, ob AS LONG, gen AS LONG)
  PDF_ADD_OBJECT_PRE = in + trimV(ob) + " " + trimV(gen) + " obj" + CHR$(13)
END FUNCTION

FUNCTION PDF_ADD_OBJECT_POST$ (in AS STRING)
  PDF_ADD_OBJECT_POST = in + "endobj" + CHR$(13)
END FUNCTION

FUNCTION PDF_ADD_HEADER$
  PDF_ADD_HEADER = "%PDF-" + PDF_VERSION + CHR$(13)
END FUNCTION

FUNCTION PDF_ADD_EOF$ (in AS STRING)
  PDF_ADD_EOF = in + "%%EOF" + CHR$(13)
END FUNCTION

FUNCTION PDF_ADD_XREFSTART$ (in AS STRING, xrs AS LONG)
  DIM s AS STRING
  s = in + "startxref" + CHR$(13)
  s = s + trimV$(xrs) + CHR$(13)
  PDF_ADD_XREFSTART$ = s
END FUNCTION

FUNCTION PDF_ADD_XREF$ (in AS STRING, cnt AS LONG)
  DIM i AS LONG
  DIM AS STRING s, b
  s = in + "xref" + CHR$(13) ' Xref
  s = s + "0 " + trimV$(cnt) + CHR$(13) ' object count
  s = s + "0000000000 65535 f " + CHR$(10)
  FOR i = 0 TO cnt - 2 '-exclude the xref itself
    b = b + pdfObject(i).objectString
    s = s + numPadZero$(10, LEN(b)) + " 00000 n " + CHR$(10)
  NEXT
  PDF_ADD_XREF$ = s
END FUNCTION

FUNCTION PDF_ADD_CATALOG$ (in AS STRING, pgs AS STRING, outlines AS STRING)
  DIM s AS STRING
  s = in + "<<" + CHR$(13)
  s = s + "/Type /Catalog" + CHR$(13)
  s = s + "/Pages " + pgs + CHR$(13)
  s = s + "/Outlines " + outlines + CHR$(13)
  s = s + ">>" + CHR$(13)
  PDF_ADD_CATALOG$ = s
END FUNCTION

FUNCTION PDF_ADD_OUTLINES$ (in AS STRING)
  DIM s AS STRING
  s = in + "<<" + CHR$(13)
  s = s + "/Type /Outlines" + CHR$(13)
  s = s + "/Count 0" + CHR$(13)
  s = s + ">>" + CHR$(13)
  PDF_ADD_OUTLINES$ = s
END FUNCTION

FUNCTION PDF_ADD_PAGES$ (in AS STRING, cnt AS LONG, kids AS STRING)
  DIM s AS STRING
  s = in + "<<" + CHR$(13)
  s = s + "/Type /Pages" + CHR$(13)
  s = s + "/Count " + trimV$(cnt) + CHR$(13)
  s = s + "/Kids [ " + kids + " ]" + CHR$(13)
  s = s + ">>" + CHR$(13)
  PDF_ADD_PAGES$ = s
END FUNCTION

FUNCTION PDF_ADD_PAGE$ (in AS STRING, parent AS STRING, fonts AS STRING, proc AS STRING, cont AS STRING, mediaBox AS STRING, cropBox AS STRING)
  DIM s AS STRING
  DIM AS LONG i
  s = in + "<<" + CHR$(13)
  s = s + "/Type /Page" + CHR$(13)
  s = s + "/Parent " + parent + CHR$(13)
  s = s + "/MediaBox [ " + mediaBox + " ]" + CHR$(13)
  s = s + "/CropBox [ " + cropBox + " ]" + CHR$(13)
  s = s + "/Contents " + cont + CHR$(13)
  s = s + "/Resources" + CHR$(13)
  s = s + "<<" + CHR$(13)
  s = s + "/ProcSet " + proc + CHR$(13)
  s = s + "/Font" + CHR$(13)
  s = s + "<<" + CHR$(13)
  s = s + fonts + CHR$(13)
  s = s + ">>" + CHR$(13)
  IF pdfStates.imgCount > 0 THEN
    s = s + "/XObject << "
    FOR i = 1 TO pdfStates.imgCount
      s = s + "/" + pdfImage(i).nm + " " + trimV(pdfImage(i).obj) + " 0 R "
    NEXT
    s = s + " >> "
  END IF
  s = s + ">>" + CHR$(13)
  s = s + ">>" + CHR$(13)
  PDF_ADD_PAGE$ = s
END FUNCTION

FUNCTION PDF_ADD_TRAILER$ (in AS STRING, cnt AS LONG, info AS LONG)
  DIM s AS STRING
  s = in + "trailer" + CHR$(13) ' trailer
  s = s + "<<" + CHR$(13)
  s = s + "/Size " + trimV(cnt) + CHR$(13)
  s = s + "/Root 1 0 R" + CHR$(13)
  s = s + "/Info " + trimV(info) + " 0 R" + CHR$(13)
  s = s + ">>" + CHR$(13)
  PDF_ADD_TRAILER = s
END FUNCTION

FUNCTION PDF_ADD_PAGE_CONTENT$ (in AS STRING, textStream AS STRING)
  DIM AS STRING s
  IF pdfDefault.compressedText THEN
    textStream = encode85(_DEFLATE$(textStream))
  END IF

  s = in + "<< /Length " + trimV$(LEN(textStream)) + CHR$(13)

  IF pdfDefault.compressedText THEN
    s = s + "/Filter [/ASCII85Decode /FlateDecode] " + CHR$(13)
  END IF
  s = s + " >>" + CHR$(13)
  s = s + "stream" + CHR$(13)
  s = s + textStream + CHR$(13) ' insert Text Stream
  s = s + "endstream" + CHR$(13)
  PDF_ADD_PAGE_CONTENT = s
END FUNCTION

FUNCTION PDF_ADD_FONT$ (in AS STRING, fname AS STRING, basefont AS STRING, encoding AS STRING)
  DIM s AS STRING
  s = in + "<<" + CHR$(13)
  s = s + "/Type /Font" + CHR$(13)
  s = s + "/Subtype /Type1" + CHR$(13)
  s = s + "/Name /" + fname + CHR$(13)
  s = s + "/BaseFont /" + basefont + CHR$(13)
  s = s + "/Encoding /" + encoding + CHR$(13)
  s = s + ">>" + CHR$(13)
  PDF_ADD_FONT = s
END FUNCTION

' Beginning with PDF 1.4, this feature is considered obsolete
FUNCTION PDF_ADD_PROC$ (in AS STRING, pr AS _BYTE)
  DIM AS STRING s, p
  p = ""
  IF pr AND PDF_PROC_PDF THEN p = p + "/PDF "
  IF pr AND PDF_PROC_TEXT THEN p = p + "/Text "
  IF pr AND PDF_PROC_IMAGEB THEN p = p + "/ImageB "
  IF pr AND PDF_PROC_IMAGEC THEN p = p + "/ImageC "
  IF pr AND PDF_PROC_IMAGEI THEN p = p + "/ImageI "
  s = in + "[ " + p + "]" + CHR$(13)
  PDF_ADD_PROC = s
END FUNCTION

FUNCTION PDF_ADD_DOCUMENT_INFO$ (in AS STRING)
  DIM AS STRING s
  s = in + "<< /Title (" + pdfDefault.info.title + ")" + CHR$(13)
  s = s + "/Author (" + pdfDefault.info.author + ")" + CHR$(13)
  s = s + "/Subject (" + pdfDefault.info.subject + ")" + CHR$(13)
  s = s + "/Keywords (" + pdfDefault.info.keywords + ")" + CHR$(13)
  s = s + "/Creator (" + pdfDefault.info.creator + ")" + CHR$(13)
  s = s + "/Producer (" + pdfDefault.info.producer + ")" + CHR$(13)
  s = s + "/CreationDate (" + currIECTime$ + ")" + CHR$(13)
  s = s + "/ModDate (" + currIECTime$ + ")" + CHR$(13)
  s = s + ">>" + CHR$(13)
  PDF_ADD_DOCUMENT_INFO$ = s
END FUNCTION

FUNCTION PDF_ADD_IMAGE$ (in AS STRING, im AS LONG)
  DIM AS STRING s, img
  DIM AS LONG h, w
  h = _HEIGHT(pdfImage(im).IMG)
  w = _WIDTH(pdfImage(im).IMG)

  s = in + "<< /Type /XObject" + CHR$(13)
  s = s + "/Subtype /Image" + CHR$(13)
  s = s + "/Width " + trimV(w) + CHR$(13)
  s = s + "/Height " + trimV(h) + CHR$(13)
  'DeviceGray, DeviceRGB, DeviceCMYK
  s = s + "/ColorSpace "
  SELECT CASE pdfImage(im).imageDevice
    CASE PDF_IMAGE_DEVICE_GRAY
      s = s + "/DeviceGray" + CHR$(13)
      img = encodeGrayImage(im)
    CASE PDF_IMAGE_DEVICE_RGB
      s = s + "/DeviceRGB" + CHR$(13)
      img = encodeColorImage(im)
    CASE PDF_IMAGE_DEVICE_CMYK
      s = s + "/DeviceCMYK" + CHR$(13)
      ' no encoder yet
  END SELECT
  s = s + "/BitsPerComponent 8" + CHR$(13) ' Leave this for now
  s = s + "/Length " + trimV(LEN(img)) + CHR$(13)
  s = s + "/Filter [/ASCII85Decode /FlateDecode]" + CHR$(13)
  s = s + ">>" + CHR$(13)
  s = s + "stream" + CHR$(13)
  s = s + img + CHR$(13)
  s = s + "endstream" + CHR$(13)
  PDF_ADD_IMAGE = s
END FUNCTION

FUNCTION encodeGrayImage$ (im AS LONG)
  DIM AS _UNSIGNED _BYTE gray, red, green, blue
  DIM AS STRING e: e = ""
  'Blatantly "Borrowed" from the _MEMIMAGE help example
  DIM Buffer AS _MEM: Buffer = _MEMIMAGE(pdfImage(im).IMG) 'Get a memory reference to our image
  DIM O AS _OFFSET, O_Last AS _OFFSET
  O = Buffer.OFFSET 'We start at this offset
  O_Last = Buffer.OFFSET + _WIDTH(pdfImage(im).IMG) * _HEIGHT(pdfImage(im).IMG) * 4 'We stop when we get to this offset
  'use on error free code ONLY!
  $CHECKING:OFF
  DO
    red = _MEMGET(Buffer, O, _UNSIGNED _BYTE)
    green = _MEMGET(Buffer, O + 1, _UNSIGNED _BYTE)
    blue = _MEMGET(Buffer, O + 2, _UNSIGNED _BYTE)

    gray = INT(pdfDefault.grayScaleCoeff.red * red) +_
           INT(pdfDefault.grayScaleCoeff.green * green) +_
           INT(pdfDefault.grayScaleCoeff.blue * blue)
    e = e + CHR$(gray)
    O = O + 4
  LOOP UNTIL O = O_Last
  'turn checking back on when done!
  $CHECKING:ON
  _MEMFREE Buffer

  encodeGrayImage = encode85(_DEFLATE$(e))
END FUNCTION


FUNCTION encodeColorImage$ (im AS LONG)
  DIM AS _UNSIGNED _BYTE red, green, blue
  DIM AS STRING e: e = ""
  'Blatantly "Borrowed" from the _MEMIMAGE help example
  DIM Buffer AS _MEM: Buffer = _MEMIMAGE(pdfImage(im).IMG) 'Get a memory reference to our image
  DIM O AS _OFFSET, O_Last AS _OFFSET
  O = Buffer.OFFSET 'We start at this offset
  O_Last = Buffer.OFFSET + _WIDTH(pdfImage(im).IMG) * _HEIGHT(pdfImage(im).IMG) * 4 'We stop when we get to this offset
  'use on error free code ONLY!
  $CHECKING:OFF
  DO
    red = _MEMGET(Buffer, O, _UNSIGNED _BYTE)
    e = e + CHR$(red)
    green = _MEMGET(Buffer, O + 1, _UNSIGNED _BYTE)
    e = e + CHR$(green)
    blue = _MEMGET(Buffer, O + 2, _UNSIGNED _BYTE)
    e = e + CHR$(blue)
    O = O + 4
  LOOP UNTIL O = O_Last
  'turn checking back on when done!
  $CHECKING:ON
  _MEMFREE Buffer
  encodeColorImage = encode85(_DEFLATE$(e))
END FUNCTION

FUNCTION trimV$ (v AS SINGLE)
  trimV = _TRIM$(STR$(v))
END FUNCTION

FUNCTION numPadZero$ (pad AS LONG, num AS LONG)
  DIM AS LONG i, s
  DIM AS STRING p, n
  p = STRING$(pad, "0")
  n = _TRIM$(STR$(num))
  s = LEN(p) - LEN(n)
  FOR i = 1 TO LEN(n)
    MID$(p, s + i) = MID$(n, i, 1)
  NEXT
  numPadZero$ = p
END FUNCTION

FUNCTION insertText$ (text AS STRING, insert AS STRING, ps AS LONG)
  DIM AS STRING l, r
  l = LEFT$(text, ps)
  r = RIGHT$(text, LEN(text) - ps)
  insertText$ = l + insert + r
END FUNCTION

FUNCTION escapeSeq$ (text AS STRING)
  DIM AS LONG i
  DIM AS STRING ch
  i = 1: DO UNTIL i > LEN(text)
    ch = MID$(text, i, 1)
    SELECT CASE ASC(ch)
      CASE 8 '\b    Backspace (BS)
        MID$(text, i) = "\"
        text = insertText(text, "b", i)
      CASE 9 '\t    Horizontal tab (HT)
        MID$(text, i) = "\"
        text = insertText(text, "t", i)
      CASE 10 '\n   Line feed (LF)
        MID$(text, i) = "\"
        text = insertText(text, "n", i)
      CASE 12 '\f   Form feed (FF)
        MID$(text, i) = "\"
        text = insertText(text, "f", i)
      CASE 13 '\r   Carriage return (CR)
        MID$(text, i) = "\"
        text = insertText(text, "r", i)
      CASE 40 '\(   Left parenthesis
        MID$(text, i) = "\"
        text = insertText(text, "(", i)
        i = i + 1
      CASE 41 '\)   Right parenthesis
        MID$(text, i) = "\"
        text = insertText(text, ")", i)
        i = i + 1
      CASE 92 '\\   Backslash  or \ddd octal
        'To Do: check if variable
        IF NOT isDigit(MID$(text, i + 1, 1)) THEN ' if digit assume its octal triplit
          MID$(text, i) = "\"
          text = insertText(text, "\", i)
          i = i + 1 'jump pass the slash
        END IF
    END SELECT
  i = i + 1: LOOP
  escapeSeq = text
END FUNCTION

FUNCTION isDigit (s AS STRING)
  isDigit = INSTR("0123456789", s) > 0
END FUNCTION

SUB clearPdf
  REDIM pdfStates AS tPDFSTATE
  REDIM pdfCommand(0) AS tPDFCOMMAND
  REDIM pdfFont(0 TO 1) AS tPDFFONT
  REDIM pdfPage(0 TO 1) AS tPDFPAGE
  REDIM pdfObject(0 TO 1) AS tPDFOBJECT
  REDIM pdfObjectString(0 TO 20) AS STRING
  REDIM pdfImage(0 TO 1) AS tPDFIMAGE
END SUB

FUNCTION encode85$ (in AS STRING)
  DIM AS LONG l
  DIM AS STRING o, i, k
  o = ""
  i = in
  l = 4 - (LEN(i) MOD 4)
  IF (LEN(i) MOD 4) > 0 THEN i = i + STRING$(l, CHR$(0))
  DO
    k = LEFT$(i, 4)
    o = o + en85$(k)
    i = MID$(i, 5)
  LOOP WHILE LEN(i)
  o = LEFT$(o, LEN(o) - l)
  encode85 = o + "~>"
END FUNCTION

FUNCTION en85$ (in AS STRING)
  DIM AS _UNSIGNED LONG x
  DIM AS STRING o: o = "     "
  x = _SHL(ASC(in, 1), 24) OR _SHL(ASC(in, 2), 16) OR _SHL(ASC(in, 3), 8) OR ASC(in, 4)
  ASC(o, 5) = ((x MOD 85) + 33)
  x = (INT(x / 85))
  ASC(o, 4) = ((x MOD 85) + 33)
  x = (INT(x / 85))
  ASC(o, 3) = ((x MOD 85) + 33)
  x = (INT(x / 85))
  ASC(o, 2) = ((x MOD 85) + 33)
  x = (INT(x / 85))
  ASC(o, 1) = ((x MOD 85) + 33)
  x = (INT(x / 85))
  en85$ = o
END FUNCTION


'(D:YYYYMMDDHHmmSSOHH'mm')
'where
'YYYY is the year
'MM is the month
'DD is the day (01-31)
'HH is the hour (00-23)
'mm is the minute (00-59)
'SS is the second (00-59)
'O is the relationship of local time to Universal Time (UT), denoted by one of
'the characters +, -, or Z (see below)
'HH followed by ' is the absolute value of the offset from UT in hours (00-23)
'mm followed by ' is the absolute value of the offset from UT in minutes (00-59)

FUNCTION CurrYear$
  CurrYear$ = RIGHT$(DATE$, 4)
END FUNCTION
FUNCTION currMonth$
  currMonth$ = LEFT$(DATE$, 2)
END FUNCTION
FUNCTION currDay$
  currDay$ = MID$(DATE$, 4, 2)
END FUNCTION
FUNCTION currHour$
  currHour$ = LEFT$(TIME$, 2)
END FUNCTION
FUNCTION currMin$
  currMin$ = MID$(TIME$, 4, 2)
END FUNCTION
FUNCTION currSec$
  currSec$ = MID$(TIME$, 7, 2)
END FUNCTION

FUNCTION IECTimeDate$ (year AS STRING, month AS STRING, day AS STRING, hour AS STRING, minute AS STRING, second AS STRING, O AS STRING, HH AS STRING, mm AS STRING)
  IECTimeDate = "D:" + year + month + day + hour + minute + second + " " + O + HH + "'" + mm + "'"
END FUNCTION
FUNCTION currIECTime$
  currIECTime$ = IECTimeDate$(CurrYear, currMonth, currDay, currHour, currMin, currSec, _
                pdfDefault.info.creationDate.O, pdfDefault.info.creationDate.HH, pdfDefault.info.creationDate.mm)
END FUNCTION

FUNCTION nToOctal$ (nn AS INTEGER)
  DIM AS LONG n: n = nn
  DIM AS STRING octalNum
  DO WHILE n <> 0
    octalNum = octalNum + _TRIM$(STR$(n MOD 8))
    n = INT(n / 8)
  LOOP
  nToOctal = numPadZero(3, VAL(octalNum)) 'stupid but it works
END FUNCTION

FUNCTION fixDecNot! (a AS SINGLE) 'truncates excessive decimal points
  fixDecNot! = INT(a * 10000.0!) / 10000.0!
END FUNCTION

