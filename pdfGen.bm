SUB pdfClosePath
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Close the current subpath by appending a straight line segment from the current point to the starting point of the subpath.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   None.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF ClosePath Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T xC! = 300
  '_pdf_T yC! = 350
  '_pdf_T pdfBeginPath xC! + 5, yC! 'Start the path
  '_pdf_T pdfAppendLine xC! + 100, yC! + 100 'Points along the path
  '_pdf_T pdfAppendLine xC! + 100, yC! - 100 'Points along the path
  '_pdf_T pdfClosePath 'close path to the start
  '_pdf_T
  '_pdf_T pdfBeginPath xC! - 5, yC! 'Start the path
  '_pdf_T pdfAppendLine xC! - 100, yC! - 100 'Points along the path
  '_pdf_T pdfAppendLine xC! - 100, yC! + 100 'Points along the path
  '_pdf_T pdfClosePath 'close path to the start
  '_pdf_T
  '_pdf_T pdfStrokePath ' Path is not drawn until now
  '_pdf_T
  '_pdf_T pdfGen "pdfClosePathExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_CLOSE_PATH
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
