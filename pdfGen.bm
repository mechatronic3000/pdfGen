SUB pdfSetRenderMode (m AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T The text rendering mode determines whether showing text causes glyph outlines to be stroked, filled, used as a clipping boundary, or some combination of the three.
  '_pdf_@F1,12W70L12T
  '_pdf_T   PDF_RENDER_MODE_FILL - Fill text.
  '_pdf_T   PDF_RENDER_MODE_STROKE - Stroke text.
  '_pdf_T   PDF_RENDER_MODE_FILL_STROKE - Fill, then stroke text.
  '_pdf_T   PDF_RENDER_MODE_INVISIBLE - Neither fill nor stroke text (invisible).
  '_pdf_T   PDF_RENDER_MODE_FILL_ADD_PATH - Fill text and add to path for clipping
  '_pdf_T   PDF_RENDER_MODE_STROKE_ADD_PATH - Stroke text and add to path for clipping.
  '_pdf_T   PDF_RENDER_MODE_FILL_STROKE_ADD_PATH - Fill, then stroke text and add to path for clipping.
  '_pdf_T   PDF_RENDER_MODE_ADD_PATH - Add text to path for clipping.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   m - mode
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L11T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF RenderMode Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_BOLD
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 64
  '_pdf_T pdfSetPosition 200, 414 'Initial position
  '_pdf_T pdfSetStrokeWidth .25
  '_pdf_T pdfSetRenderMode PDF_RENDER_MODE_STROKE_ADD_PATH
  '_pdf_T pdfAddText "pdfGEN"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 200, 480 'Initial position
  '_pdf_T pdfSetFontSize "F1", 6: pdfSetLeading 6
  '_pdf_T pdfSetRenderMode PDF_RENDER_MODE_FILL
  '_pdf_T FOR i& = 0 TO 1000: s$ = s$ + "clipped": NEXT
  '_pdf_T pdfAddTextBlock 100, s$
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfRenderModeExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_TEXT_RENDER_MODE
  pdfCommand(ub).argLong1 = m
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
