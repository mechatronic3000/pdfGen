  '_pdf_T  pdfAddPage
  '_pdf_T  pdfBeginText
  '_pdf_T  pdfSetFontSize "F1", 14
  '_pdf_T  FOR deg! = 0 TO 360 STEP 15
  '_pdf_T    pdfRotateText 300, 400, deg!
  '_pdf_T    pdfAddText "           This is some text. "
  '_pdf_T  NEXT
  '_pdf_T  pdfEndText
  '_pdf_T
  '_pdf_T  pdfGen "pdfRotateTextExample.pdf"
  '_pdf_T  SYSTEM
  '_pdf_T  '$INCLUDE:'pdfGen.bm'

  pdfSetMatrix COS(_D2R(deg)), SIN(_D2R(deg)), -SIN(_D2R(deg)), COS(_D2R(deg)), x, y
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfSetMatrix (a AS SINGLE, b AS SINGLE, _
c AS SINGLE, d AS SINGLE, _
e AS SINGLE, f AS SINGLE)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Set the text matrix.
  '_pdf_@F3,14W180L14
  '_pdf_T
  '_pdf_T   \351              \371
  '_pdf_T   \352              \372
  '_pdf_T   \353              \373
  '_pdf_T
  '_pdf_EB#50,650@F1,14W60L16
  '_pdf_T a b 0
  '_pdf_T c d 0  = [a b c d e f]
  '_pdf_T e f 1
  '_pdf_T
  '_pdf_T * Translations are specified as [1 0 0 1 tx ty ], where tx and ty are the distances to translate the origin of the coordinate system in the horizontal and vertical dimensions, respectively.
  '_pdf_T * Scaling is obtained by [sx 0 0 sy 0 0]. This scales the coordinates so that 1 unit in the horizontal and vertical dimensions of the new coordinate system is the same size as sx and sy units, respectively, in the previous coordinate system.
  '_pdf_T * Rotations are produced by [cos \371 sin \371 -sin \371 cos \371 0 0], which has the effect of rotating the coordinate system axes by an angle counterclockwise.
  '_pdf_t * Skew is specified by [1 tan
  '_pdf_@F3,14t  \141
  '_pdf_@F1,14t tan
  '_pdf_@F3,14t  \142
  '_pdf_@F1,14T 1 0 0], which skews
  '_pdf_t the x axis by an angle
  '_pdf_@F3,14t  \141
  '_pdf_@F1,14t and the y axis by an angle
  '_pdf_@F3,14T  \142.
  '_pdf_T
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   a-f elements of the matrix.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_+#40,740@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF SetMatrix Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 36
  '_pdf_T
  '_pdf_T xp! = 50 ' x position
  '_pdf_T yp! = 700 ' y position
  '_pdf_T pdfSetMatrix 1, 0, 0, 1, xp!, yp!
  '_pdf_T pdfAddText "This is normal text."
  '_pdf_T
  '_pdf_T scaleX! = 2 ' x scale
  '_pdf_T scaleY! = 2 ' y scale
  '_pdf_T pdfSetMatrix scaleX!, 0, 0, scaleY!, xp!, yp! - 100.0
  '_pdf_T pdfAddText "This is scaled text. "
  '_pdf_T
  '_pdf_T alpha! = 0.0 ' angle from x axis
  '_pdf_T beta! = 45.0 ' angle from y axis
  '_pdf_T pdfSetMatrix 1, TAN(_D2R(alpha!)), TAN(_D2R(beta!)), 1, xp!, yp! - 200
  '_pdf_T pdfAddText "This is skewed text. "
  '_pdf_T
  '_pdf_T theta! = 30.0 ' angle of rotation
  '_pdf_T pdfSetMatrix COS(_D2R(theta!)), SIN(_D2R(theta!)), -SIN(_D2R(theta!)), COS(_D2R(theta!)), xp!, yp! - 400
  '_pdf_T pdfAddText "This is rotated text. "
  '_pdf_T
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfGen "pdfSetMatrixExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'
  '_pdf_E
  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_SET_MATRIX
  pdfCommand(ub).mat.a = a
  pdfCommand(ub).mat.b = b
  pdfCommand(ub).mat.c = c
  pdfCommand(ub).mat.d = d
  pdfCommand(ub).mat.e = e
  pdfCommand(ub).mat.f = f
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfRotateImage (x AS LONG, y AS LONG, deg AS SINGLE)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T  Helper function to set the matrix for a rotation around a fixed cooridinate.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T  x - position
  '_pdf_T  y - position
  '_pdf_T  deg - angle in degrees around fixed point
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W80L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T
  '_pdf_T pdfSetTitle "PDF Rotate Image Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadImage "Icon.png", "Im1"
  '_pdf_T
  '_pdf_T pdfAddPage
  '_pdf_T FOR theta! = 0 TO 360 STEP 15
  '_pdf_T   pdfPushGraphicsStack
  '_pdf_T   pdfSetImageMatrix 100, 0, 0, 100, 300, 600
  '_pdf_T   pdfRotateImage 0, 0, theta!
  '_pdf_T   pdfPutImage "Im1"
  '_pdf_T   pdfPopGraphicsStack
  '_pdf_T NEXT
  '_pdf_T
  '_pdf_T pdfGen "pdfRotateImage.pdf"
  '_pdf_T
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  pdfSetImageMatrix COS(_D2R(deg)), SIN(_D2R(deg)), -SIN(_D2R(deg)), COS(_D2R(deg)), x, y
END SUB
