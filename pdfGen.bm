'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfFillPath
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Fill the path, using the nonzero winding number rule to determine the region to fill. Any subpaths that are open are implicitly closed before being filled.
  '_pdf_T
  '_pdf_@F2,14W60L16T Nonzero Winding Number Rule :
  '_pdf_T
  '_pdf_@F1,14W60L16T The nonzero winding number rule determines whether a given point is inside a path by conceptually drawing a ray from that point to infinity in any direction and then examining the places where a segment of the path crosses the ray. Starting with a count of 0, the rule adds 1 each time a path segment crosses the ray from left to right and subtracts 1 each time a segment crosses from right to left. After counting all the crossings, if the result is 0, the point is outside the path; otherwise, it is inside.
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   None.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_E+#40,740@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W100L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF General Path Showcase Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T pdfSetStrokeWidth 4
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 18
  '_pdf_T pdfSetPosition 100, 710
  '_pdf_T pdfAddText "StrokePath Example (Does not close shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginPath 100, 700
  '_pdf_T pdfAppendLine 500, 700
  '_pdf_T pdfAppendLine 500, 650
  '_pdf_T pdfAppendLine 100, 650
  '_pdf_T pdfStrokePath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 610
  '_pdf_T pdfAddText "CloseStrokePath Example (Closes shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginPath 100, 600
  '_pdf_T pdfAppendLine 500, 600
  '_pdf_T pdfAppendLine 500, 550
  '_pdf_T pdfAppendLine 100, 550
  '_pdf_T pdfCloseStrokePath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 510
  '_pdf_T pdfAddText "FillPath Example (Fills shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfSetStrokeWidth 1
  '_pdf_T rad! = 75: xc! = 300: yc! = 420
  '_pdf_T star rad!, xc!, yc!
  '_pdf_T pdfFillPath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 300
  '_pdf_T pdfAddText "FillEO Example (Fills Even Odd Shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T rad! = 75: xc! = 300: yc! = 200
  '_pdf_T star rad!, xc!, yc!
  '_pdf_T pdfFillEO
  '_pdf_T
  '_pdf_T pdfGen "pdfPathShowcaseExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  '_pdf_T SUB star (rad!, xc!, yc!)
  '_pdf_T   pdfBeginPath xc! + rad! * SIN(0), yc! + rad! * COS(0)
  '_pdf_T   FOR i! = 1 TO 5
  '_pdf_T   pdfAppendLine xc! + rad! * SIN(_D2R(i! * 144)), yc! + rad! * COS(_D2R(i! * 144))
  '_pdf_T   NEXT
  '_pdf_T END SUB

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_FILL_PATH
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfFillEO
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Fill the path, using the even-odd rule to determine the region to fill.
  '_pdf_T
  '_pdf_@F2,14W60L16T Even-Odd Rule :
  '_pdf_T
  '_pdf_@F1,14W60L16T An alternative to the nonzero winding number rule is the even-odd rule. This rule determines whether a point is inside a path by drawing a ray from that point in any direction and simply counting the number of path segments that cross the ray, regardless of direction. If this number is odd, the point is inside; if even, the point is outside. This yields the same results as the nonzero winding number rule for paths with simple shapes, but produces different results for more complex shapes.
  '_pdf_T
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   None.
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_E+#40,740@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W100L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF General Path Showcase Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T pdfSetStrokeWidth 4
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 18
  '_pdf_T pdfSetPosition 100, 710
  '_pdf_T pdfAddText "StrokePath Example (Does not close shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginPath 100, 700
  '_pdf_T pdfAppendLine 500, 700
  '_pdf_T pdfAppendLine 500, 650
  '_pdf_T pdfAppendLine 100, 650
  '_pdf_T pdfStrokePath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 610
  '_pdf_T pdfAddText "CloseStrokePath Example (Closes shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfBeginPath 100, 600
  '_pdf_T pdfAppendLine 500, 600
  '_pdf_T pdfAppendLine 500, 550
  '_pdf_T pdfAppendLine 100, 550
  '_pdf_T pdfCloseStrokePath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 510
  '_pdf_T pdfAddText "FillPath Example (Fills shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T pdfSetStrokeWidth 1
  '_pdf_T rad! = 75: xc! = 300: yc! = 420
  '_pdf_T star rad!, xc!, yc!
  '_pdf_T pdfFillPath
  '_pdf_T
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetPosition 100, 300
  '_pdf_T pdfAddText "FillEO Example (Fills Even Odd Shape)"
  '_pdf_T pdfEndText
  '_pdf_T
  '_pdf_T rad! = 75: xc! = 300: yc! = 200
  '_pdf_T star rad!, xc!, yc!
  '_pdf_T pdfFillEO
  '_pdf_T
  '_pdf_T pdfGen "pdfPathShowcaseExample.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  '_pdf_T SUB star (rad!, xc!, yc!)
  '_pdf_T   pdfBeginPath xc! + rad! * SIN(0), yc! + rad! * COS(0)
  '_pdf_T   FOR i! = 1 TO 5
  '_pdf_T   pdfAppendLine xc! + rad! * SIN(_D2R(i! * 144)), yc! + rad! * COS(_D2R(i! * 144))
  '_pdf_T   NEXT
  '_pdf_T END SUB

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_FILL_EO
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
