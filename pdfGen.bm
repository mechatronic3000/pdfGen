'_pdf_(
SUB pdfAppendBezier123 (x1 AS LONG, y1 AS LONG, _
x2 AS LONG, y2 AS LONG, _
x3 AS LONG, y3 AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Append a cubic Bezier curve to the current path. The curve extends from the current point to the point (x3 , y3 ), using (x1 , y1 ) and (x2 , y2 ) as the Bezier control points. The new current point is (x3 , y3 )
  '_pdf_T
  '_pdf_@F2,14W60L16TParameters
  '_pdf_@F1,14W60L16T
  '_pdf_T   x1,y1 - Control point
  '_pdf_T   x2,y2 - Control point
  '_pdf_T   x3,y3 - Final point
  '_pdf_T
  '_pdf_@F2,14W60L16TReturns
  '_pdf_@F1,14W60L16T
  '_pdf_T   Nothing.
  '_pdf_T
  '_pdf_E+#40,740@F2,14W60L16TExample
  '_pdf_T _________________________________________________________
  '_pdf_@F1,10W90L10T
  '_pdf_T '$INCLUDE:'pdfGen.bi'
  '_pdf_T pdfSetTitle "PDF AppendBezier123 Example"
  '_pdf_T pdfSetAuthor "Justsomeguy"
  '_pdf_T
  '_pdf_T pdfLoadFont "F1", PDF_FONT_TIMES_ROMAN
  '_pdf_T pdfAddPage
  '_pdf_T 'Starting Point
  '_pdf_T xC! = 300
  '_pdf_T yC! = 350
  '_pdf_T 'Control Point 1
  '_pdf_T cPx1! = xC! - 50
  '_pdf_T cPy1! = yC! + 200
  '_pdf_T 'Control Point 2
  '_pdf_T cPx2! = xC!
  '_pdf_T cPy2! = yC! + 250
  '_pdf_T 'Final Point
  '_pdf_T fNx! = xC! + 200
  '_pdf_T fNy! = yC! + 200
  '_pdf_T 'draw Bezier
  '_pdf_T pdfBeginPath xC!, yC!
  '_pdf_T pdfAppendBezier123 cPx1!, cPy1!, cPx2!, cPy2!, fNx!, fNy!
  '_pdf_T pdfStrokePath
  '_pdf_T 'draw visual aids
  '_pdf_T pdfRectangle xC! - 2, yC! - 2, 4, 4
  '_pdf_T pdfStrokePath
  '_pdf_T pdfRectangle fNx! - 2, fNy! - 2, 4, 4
  '_pdf_T pdfStrokePath
  '_pdf_T pdfRectangle cPx1! - 2, cPy1! - 2, 4, 4
  '_pdf_T pdfStrokePath
  '_pdf_T pdfRectangle cPx2! - 2, cPy2! - 2, 4, 4
  '_pdf_T pdfStrokePath
  '_pdf_T pdfBeginPath cPx1!, cPy1!
  '_pdf_T pdfSetLineDashPattern 2, 2, 0
  '_pdf_T pdfAppendLine xC!, yC!
  '_pdf_T pdfStrokePath
  '_pdf_T pdfBeginPath cPx2!, cPy2!
  '_pdf_T pdfSetLineDashPattern 2, 2, 0
  '_pdf_T pdfAppendLine fNx!, fNy!
  '_pdf_T pdfStrokePath
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 14
  '_pdf_T pdfSetPosition xC! - 40, yC - 15!
  '_pdf_T pdfAddText "Starting Point"
  '_pdf_T pdfEndText
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 14
  '_pdf_T pdfSetPosition cPx1! - 40, cPy1! + 5
  '_pdf_T pdfAddText "Control Point 1"
  '_pdf_T pdfEndText
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 14
  '_pdf_T pdfSetPosition cPx2! - 40, cPy2! + 5
  '_pdf_T pdfAddText "Control Point 2"
  '_pdf_T pdfEndText
  '_pdf_T pdfBeginText
  '_pdf_T pdfSetFontSize "F1", 14
  '_pdf_T pdfSetPosition fNx! - 30, fNy! - 15
  '_pdf_T pdfAddText "End Point"
  '_pdf_T pdfEndText
  '_pdf_T pdfGen "pdfAppendBezier123Example.pdf"
  '_pdf_T SYSTEM
  '_pdf_T '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_APPEND_BEZIER_CURVE_123
  pdfCommand(ub).argVec1.x = x1
  pdfCommand(ub).argVec1.y = y1
  pdfCommand(ub).argVec2.x = x2
  pdfCommand(ub).argVec2.y = y2
  pdfCommand(ub).argVec3.x = x3
  pdfCommand(ub).argVec3.y = y3
  REDIM _PRESERVE pdfCommand(ub + 1) AS tPDFCOMMAND
END SUB
'_pdf_E+#40,740@F2,14W60L16
'_pdf_(
SUB pdfAppendBezier23 (x2 AS LONG, y2 AS LONG, _
x3 AS LONG, y3 AS LONG)
  '_pdf_)
  '_pdf_@F1,14W60L16
  '_pdf_T
  '_pdf_T Append a cubic Bezier curve to the current path. The curve extends from the current point to the point (x3, y3), using the point (x2, y2) as the Bezier control points. The new current point is (x3, y3).
  '_pdf_T
