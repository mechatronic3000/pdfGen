  '_pdf_T
  '_pdf_T   pdfAddPage
  '_pdf_T   pdfBeginText
  '_pdf_T   pdfSetPosition 50, 720 'Initial position
  '_pdf_T   pdfSetFontSize "F1", 14
  '_pdf_T   pdfAddText "This is some text. "
  '_pdf_T   pdfSetFontSize "F1", 7
  '_pdf_T   pdfSetRise 7
  '_pdf_T   pdfAddText "This is superscript"
  '_pdf_T   pdfSetRise -3
  '_pdf_T   pdfAddText "This is subscript"
  '_pdf_T   pdfSetRise 0
  '_pdf_T   pdfSetFontSize "F1", 14
  '_pdf_T   pdfAddText "This is normal text"
