  '_pdf_T   pdfEndText
  '_pdf_T
  '_pdf_T   pdfGen "pdfSetRiseExample.pdf"
  '_pdf_T   SYSTEM
  '_pdf_T   '$INCLUDE:'pdfGen.bm'

  DIM AS LONG ub
  ub = UBOUND(pdfCommand)
  pdfCommand(ub).command = PDF_COMM_TEXT_RISE
  pdfCommand(ub).argSingle1 = r
