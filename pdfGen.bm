'_pdf_E+#40,740@F2,16W70L18
'_pdf_T Purpose:
'_pdf_@F1,12L14T
'_pdf_T This library is designed to allow a user to procedurally generate PDF files.
'_pdf_T It is a low level so the user has maximum control over the appearance of the document.
'_pdf_T
'_pdf_@F2,16W70L18TFeatures:
'_pdf_@F1,12L14T
'_pdf_T Currently it only supports the 14 type 1 fonts that are built-in to most viewers.
'_pdf_T
'_pdf_T                    * Times-Roman
'_pdf_T                    * Times-Bold
'_pdf_T                    * Times-Italic
'_pdf_T                    * Times-BoldItalic
'_pdf_T                    * Helvetica
'_pdf_T                    * Helvetica-Bold
'_pdf_T                    * Helvetica-Oblique
'_pdf_T                    * Helvetica-BoldOblique
'_pdf_T                    * Courier
'_pdf_T                    * Courier-Bold
'_pdf_T                    * Courier-Oblique
'_pdf_T                    * Courier-BoldOblique
'_pdf_T                    * Symbol
'_pdf_T                    * ZapfDingbats
'_pdf_T
'_pdf_T
'_pdf_T Images can be imported scaled and rotated in the document. Most image types are supported.
'_pdf_T
'_pdf_T
'_pdf_T
'_pdf_T
'_pdf_T
'_pdf_T
'_pdf_T
'_pdf_T
'_pdf_T
'_pdf_IlIcon.png,IM1_Ip220_210_IdIM1
'_pdf_T Multicolor vector graphics can also be implemented.
'_pdf_Xw4_Xc0,.5,0_Xr40,50,500,100Xs
'_pdf_Xc.75,0,0_Xb40,50_Xl290,150_Xl540,50Xs
'_pdf_Xc0,0,.75_Xb40,150_Xl290,50_Xl540,150Xs
'_pdf_)
PRINT "Doh! I'm the library not the main program!"
SUB pdfSetVar (id AS STRING, value AS STRING)
  DIM AS LONG uB, i
  uB = UBOUND(pdfVars)
  i = 0: DO
    'check if it already exist, if so put value there
    IF pdfVars(i).varName = id THEN
      pdfVars(i).varValue = value
      EXIT SUB
    END IF
  i = i + 1: LOOP WHILE i < uB
  REDIM _PRESERVE pdfVars(uB + 1) AS tPDFVARS
  uB = UBOUND(pdfVars)
  pdfVars(uB).varName = id
  pdfVars(uB).varValue = value
END SUB
FUNCTION pdfGetVar$ (id AS STRING)
  DIM AS LONG uB, i
  uB = UBOUND(pdfVars)
  i = 0: DO
    IF UCASE$(pdfVars(i).varName) = UCASE$(id) THEN
      pdfGetVar = pdfVars(i).varValue
      EXIT FUNCTION
    END IF
  i = i + 1: LOOP WHILE i <= uB
END FUNCTION

'_pdf_E+#40,740@F2,40W40L44
